{
  "$schema": "https://app.clawnify.com/schema/v1/clawnify.json",
  "version": 1,
  "name": "Inbox",
  "icon": "icon.svg",
  "description": "One inbox for every channel your agent handles \u2014 WhatsApp, Telegram, Slack and email conversations mirrored into a single reviewable timeline, with agent-mediated replies and a per-thread audit trail of what the agent did.",
  "app": {
    "framework": "react+hono",
    "database": true,
    "storage": true,
    "credentials": [
      "whatsapp-business",
      "twilio"
    ]
  },
  "api": {
    "public_routes": [
      "/api/media/**",
      {
        "path": "/api/sms/inbound",
        "methods": [
          "POST"
        ]
      },
      {
        "path": "/api/sms/status",
        "methods": [
          "POST"
        ]
      }
    ]
  },
  "env": {
    "optional": [
      "CRM_APP_ID",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN"
    ]
  }
}
